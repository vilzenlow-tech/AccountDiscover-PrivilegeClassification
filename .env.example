# --- Application ---
APP_NAME=adpct
APP_ENV=development
APP_SECRET_KEY=change-me-please-to-a-long-random-string
APP_JWT_ALG=HS256
APP_ACCESS_TOKEN_TTL_MIN=60
APP_REFRESH_TOKEN_TTL_MIN=720
APP_CORS_ORIGINS=http://localhost:5173
APP_RATE_LIMIT_LOGIN_PER_MIN=5

# --- Database ---
DATABASE_URL=postgresql+psycopg://adpct:adpct@postgres:5432/adpct

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Collector mode ---
# Demo mode is development-only and must remain false for UAT/staging/production.
DEMO_MODE=false
DEMO_SEED_ENABLED=false

# mock | live. Use mock only in local development/test with explicit intent.
COLLECTOR_MODE=live
COLLECTOR_SSH_TIMEOUT=30
COLLECTOR_WINRM_TIMEOUT=30
COLLECTOR_DB_TIMEOUT=20

# --- Lab integration targets ---
RHEL_TEST_HOST=192.168.7.130
RHEL_TEST_USERNAME=root
RHEL_TEST_PASSWORD=

MYSQL_TEST_HOST=192.168.7.130
MYSQL_TEST_PORT=3306
MYSQL_TEST_USERNAME=
MYSQL_TEST_PASSWORD=

MONGO_TEST_HOST=192.168.7.130
MONGO_TEST_PORT=27017
MONGO_TEST_USERNAME=
MONGO_TEST_PASSWORD=

# --- Credential vault ---
# local | cyberark | hashicorp | azure | aws
VAULT_PROVIDER=local
# Only used for local provider (dev only). In production, set a real vault.
VAULT_LOCAL_FERNET_KEY=

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
