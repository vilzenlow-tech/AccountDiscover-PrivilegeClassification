# --- Application ---
APP_NAME=adpct
APP_ENV=dev
APP_SECRET_KEY=change-me-please-to-a-long-random-string
APP_JWT_ALG=HS256
APP_ACCESS_TOKEN_TTL_MIN=60
APP_REFRESH_TOKEN_TTL_MIN=720
APP_CORS_ORIGINS=http://localhost:5173
APP_RATE_LIMIT_LOGIN_PER_MIN=5

# --- Database ---
DATABASE_URL=postgresql+psycopg://adpct:adpct@postgres:5432/adpct

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Collector mode ---
# mock | live
COLLECTOR_MODE=mock
COLLECTOR_SSH_TIMEOUT=30
COLLECTOR_WINRM_TIMEOUT=30
COLLECTOR_DB_TIMEOUT=20

# --- Credential vault ---
# local | cyberark | hashicorp | azure | aws
VAULT_PROVIDER=local
# Only used for local provider (dev only). In production, set a real vault.
VAULT_LOCAL_FERNET_KEY=

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
